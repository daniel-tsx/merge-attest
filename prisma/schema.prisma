generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  owner
  admin
  member
  viewer
}

enum OrganizationInviteStatus {
  pending
  accepted
  expired
  revoked
}

enum BillingStatus {
  trialing
  active
  past_due
  paused
  canceled
}

enum RepositoryProvider {
  github
}

enum RepositoryVisibility {
  public
  private
}

enum ConnectionStatus {
  connected
  disconnected
  demo
}

enum RiskProfile {
  low
  medium
  high
}

enum PullRequestStatus {
  open
  merged
  closed
}

enum AgentSource {
  cursor
  codex
  claude_code
  copilot
  devin
  manual
  unknown
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum TestGapStatus {
  none
  warning
  high
}

enum CiStatus {
  pending
  passing
  failing
  unknown
}

enum ApprovalStatus {
  not_required
  pending
  approved
  rejected
  risk_accepted
}

enum ActivityEventType {
  pr_opened
  commit_pushed
  files_changed
  ci_failed
  ci_passed
  rule_triggered
  approval_requested
  approved
  rejected
  merged
}

enum RuleTriggerType {
  ai_assisted
  high_risk
  auth_changed
  billing_changed
  database_migration
  dependency_changed
  high_test_gap
  failing_ci
}

enum RuleActionType {
  warn
  require_approval
  block_merge
  request_tests
  request_security_review
  publish_github_check
}

enum Severity {
  low
  medium
  high
  critical
}

enum ApprovalDecision {
  approved
  rejected
  requested_tests
  risk_accepted
  not_required
}

enum AiReviewStatus {
  queued
  in_progress
  blocked
  skipped
  completed
  failed
}

enum AiReviewProvider {
  openrouter
}

enum AiReviewDepth {
  standard
  deep
}

enum AuditEventType {
  repository_connected
  pr_synced
  risk_score_calculated
  test_gap_detected
  rule_triggered
  approval_requested
  pr_approved
  pr_rejected
  risk_accepted
  github_comment_posted
  github_check_run_published
  settings_changed
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships          OrganizationMember[]
  approvals            Approval[]
  assignedPullRequests PullRequest[]        @relation("AssignedPullRequests")
  comments             PullRequestComment[]
  sentInvites          OrganizationInvite[] @relation("OrganizationInvitesSent")
  acceptedInvites      OrganizationInvite[] @relation("OrganizationInvitesAccepted")
  auditExports         AuditExport[]
  apiKeys              ApiKey[]
  aiProviderCredentials AiProviderCredential[]
  sessions             Session[]
  accounts             Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id                       String        @id @default(cuid())
  name                     String
  slug                     String        @unique
  githubInstallationId     String?
  githubAccountId          String?
  githubAccountLogin       String?
  lemonSqueezyCustomerId         String?
  lemonSqueezySubscriptionId     String?
  lemonSqueezySubscriptionStatus String?
  lemonSqueezyVariantId          String?
  lemonSqueezyPriceId            String?
  planKey                  String        @default("free")
  billingStatus            BillingStatus @default(active)
  trialEndsAt              DateTime?
  cancellationEffectiveAt  DateTime?
  failedPaymentAt          DateTime?
  lastUpgradeAt            DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  members                  OrganizationMember[]
  repositories             Repository[]
  pullRequests             PullRequest[]
  activity                 AgentActivity[]
  auditEvents              AuditEvent[]
  plans                    Plan[]
  usageRecords             UsageRecord[]
  apiKeys                  ApiKey[]
  aiProviderCredentials    AiProviderCredential[]
  aiReviewJobs             AiReviewJob[]
  repositoryReviewSettings RepositoryReviewSettings[]
  webhookDeliveries        GitHubWebhookDelivery[]
  billingWebhookEvents     BillingWebhookEvent[]
  invites                  OrganizationInvite[]
  auditExports             AuditExport[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  role           OrganizationRole @default(member)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model OrganizationInvite {
  id             String                   @id @default(cuid())
  email          String
  role           OrganizationRole         @default(member)
  status         OrganizationInviteStatus @default(pending)
  token          String                   @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String?
  acceptedById   String?
  organizationId String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("OrganizationInvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("OrganizationInvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email])
}

model Repository {
  id                  String               @id @default(cuid())
  name                String
  provider            RepositoryProvider   @default(github)
  owner               String
  githubRepositoryId  String?
  githubNodeId        String?
  url                 String?
  defaultBranch       String               @default("main")
  visibility          RepositoryVisibility
  connectedStatus     ConnectionStatus     @default(demo)
  lastSyncedAt        DateTime?
  activeRulesCount    Int                  @default(0)
  monthlyPrCheckUsage Int                  @default(0)
  riskProfile         RiskProfile          @default(medium)
  providerMetadata    Json                 @default("{}")
  organizationId      String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pullRequests   PullRequest[]
  rules          RepoRule[]
  activity       AgentActivity[]
  auditEvents    AuditEvent[]
  aiReviewJobs   AiReviewJob[]
  reviewSettings RepositoryReviewSettings?

  @@unique([organizationId, githubRepositoryId])
  @@index([organizationId])
}

model PullRequest {
  id                        String            @id @default(cuid())
  number                    Int
  title                     String
  author                    String
  githubPullRequestId       String?
  githubNodeId              String?
  githubAgentGateCommentId  String?
  githubAgentGateCheckRunId String?
  url                       String?
  headSha                   String?
  branch                    String
  baseBranch                String
  status                    PullRequestStatus
  aiAssisted                Boolean?
  agentSource               AgentSource       @default(unknown)
  riskScore                 Int               @default(0)
  riskLevel                 RiskLevel         @default(low)
  testGapStatus             TestGapStatus     @default(none)
  ciStatus                  CiStatus          @default(unknown)
  approvalStatus            ApprovalStatus    @default(not_required)
  filesChangedCount         Int               @default(0)
  linesAdded                Int               @default(0)
  linesDeleted              Int               @default(0)
  assignedReviewerId        String?
  reviewDueAt               DateTime?
  repositoryId              String
  organizationId            String
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository       Repository           @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  assignedReviewer User?                @relation("AssignedPullRequests", fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  files            PullRequestFile[]
  riskSignals      RiskSignal[]
  testGapAnalysis  TestGapAnalysis?
  ruleViolations   RuleViolation[]
  approvals        Approval[]
  comments         PullRequestComment[]
  activity         AgentActivity[]
  auditEvents      AuditEvent[]
  aiReviewJobs     AiReviewJob[]

  @@unique([repositoryId, number])
  @@unique([repositoryId, githubPullRequestId])
  @@index([organizationId])
  @@index([assignedReviewerId])
  @@index([reviewDueAt])
}

model PullRequestFile {
  id            String @id @default(cuid())
  path          String
  additions     Int
  deletions     Int
  changeType    String
  pullRequestId String

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
}

model RiskSignal {
  id            String    @id @default(cuid())
  key           String
  label         String
  score         Int
  level         RiskLevel
  filePaths     Json      @default("[]")
  pullRequestId String
  createdAt     DateTime  @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
}

model TestGapAnalysis {
  id            String        @id @default(cuid())
  status        TestGapStatus
  summary       String
  affectedFiles Json          @default("[]")
  confidence    String
  pullRequestId String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  pullRequest PullRequest         @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  suggestions TestGapSuggestion[]
}

model TestGapSuggestion {
  id                String @id @default(cuid())
  testFile          String
  testCase          String
  testGapAnalysisId String

  analysis TestGapAnalysis @relation(fields: [testGapAnalysisId], references: [id], onDelete: Cascade)
}

model RepoRule {
  id               String          @id @default(cuid())
  name             String
  description      String
  enabled          Boolean         @default(true)
  triggerType      RuleTriggerType
  actionType       RuleActionType
  severity         Severity
  branchPattern    String?
  pathPattern      String?
  labelPattern     String?
  agentSource      AgentSource?
  minimumRiskLevel RiskLevel?
  codeOwnerHint    String?
  repositoryId     String
  organizationId   String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  repository Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  violations RuleViolation[]

  @@index([organizationId])
}

model RuleViolation {
  id            String   @id @default(cuid())
  summary       String
  resolved      Boolean  @default(false)
  ruleId        String
  pullRequestId String
  createdAt     DateTime @default(now())

  rule        RepoRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
}

model Approval {
  id            String           @id @default(cuid())
  decision      ApprovalDecision
  note          String?
  reviewerId    String?
  pullRequestId String
  createdAt     DateTime         @default(now())

  reviewer    User?       @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
}

model PullRequestComment {
  id            String   @id @default(cuid())
  body          String
  authorId      String?
  pullRequestId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId, createdAt])
}

model AiProviderCredential {
  id             String           @id @default(cuid())
  provider       AiReviewProvider @default(openrouter)
  encryptedKey   String
  lastVerifiedAt DateTime?
  userId         String?
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@index([userId])
}

model AiReviewJob {
  id                   String           @id @default(cuid())
  reviewKey            String           @unique
  provider             AiReviewProvider @default(openrouter)
  model                String?
  status               AiReviewStatus   @default(queued)
  statusDetail         String?
  githubDeliveryId     String?
  queueJobId           String?
  githubReviewId       String?
  githubManagedCommentId String?
  githubCheckRunId     String?
  attemptCount         Int              @default(0)
  commentsCount        Int              @default(0)
  skippedCommentsCount Int              @default(0)
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  organizationId       String
  repositoryId         String
  pullRequestId        String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pullRequest  PullRequest  @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([repositoryId, status])
  @@index([pullRequestId])
  @@index([status, createdAt])
  @@index([githubDeliveryId])
}

model RepositoryReviewSettings {
  id                    String        @id @default(cuid())
  aiReviewsEnabled      Boolean       @default(false)
  reviewDepth           AiReviewDepth @default(standard)
  minimumSeverity       Severity      @default(medium)
  model                 String?
  ignoredPaths          Json          @default("[]")
  stackTags             Json          @default("[]")
  publishInlineComments Boolean       @default(true)
  publishManagedComment Boolean       @default(true)
  publishCheckRun       Boolean       @default(true)
  organizationId        String
  repositoryId          String        @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AgentActivity {
  id             String            @id @default(cuid())
  timestamp      DateTime          @default(now())
  actor          String
  agentSource    AgentSource
  eventType      ActivityEventType
  summary        String
  riskLevel      RiskLevel
  metadata       Json              @default("{}")
  repositoryId   String
  pullRequestId  String?
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pullRequest  PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
}

model AuditEvent {
  id             String         @id @default(cuid())
  eventType      AuditEventType
  actor          String?
  summary        String
  metadata       Json           @default("{}")
  organizationId String
  repositoryId   String?
  pullRequestId  String?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository?  @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  pullRequest  PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
}

model AuditExport {
  id             String   @id @default(cuid())
  fileName       String
  format         String   @default("csv")
  filters        Json     @default("{}")
  eventCount     Int      @default(0)
  createdById    String?
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model Plan {
  id                 String   @id @default(cuid())
  key                String
  name               String
  priceMonthly       Int
  repositoryLimit    String?
  prCheckLimit       String?
  auditRetentionDays Int?
  features           Json     @default("[]")
  organizationId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id             String   @id @default(cuid())
  metric         String
  quantity       Int
  sourceKey      String?
  periodStart    DateTime
  periodEnd      DateTime
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart, sourceKey])
  @@index([organizationId, metric, periodStart])
}

model ApiKey {
  id             String    @id @default(cuid())
  name           String
  prefix         String
  hashedKey      String
  lastUsedAt     DateTime?
  userId         String?
  organizationId String
  createdAt      DateTime  @default(now())

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model GitHubWebhookDelivery {
  id             String    @id @default(cuid())
  deliveryId     String    @unique
  event          String
  action         String?
  status         String    @default("received")
  message        String?
  attemptCount   Int       @default(0)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  lastError      String?
  metadata       Json      @default("{}")
  organizationId String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([event])
  @@index([status])
  @@index([nextRetryAt])
}

model BillingWebhookEvent {
  id             String    @id @default(cuid())
  deliveryId     String    @unique
  eventName      String
  status         String    @default("processing")
  message        String?
  organizationId String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([eventName])
  @@index([status])
  @@index([createdAt])
}
